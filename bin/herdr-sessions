#!/bin/bash
# herdr-sessions — what the herdr widget needs to know, as JSON.
#
# Herdr runs one server per named session. `herdr session list` knows which
# ones exist, and each running server answers `api snapshot` with the agents
# and workspaces inside it. This script joins the two, adds the Hyprland
# window that is showing each session, and prints one object the panel can
# draw without any further work.
#
#   list          every session, running or stopped
#   open <name>   focus the window showing that session, or open one
#   focus <name> <pane>
#                 the same, but land on one agent's pane inside it
#   kill <name>   signal the session's server until it is gone
#   delete <name> remove a stopped session's directory
#   new <name> [dir]
#                 start a session that does not exist yet, opened in dir
#   prompt <name> <pane>
#                 send stdin to that agent, wait for it, print what it shows
#   --host <h> <command>
#                 run any of the above against another machine over ssh
#   demo on|off   invented sessions instead of yours, for screenshots
#
# Demo mode exists so a screenshot never carries real project names or agent
# titles, and so it looks the same in a year. Every write is a no-op while it
# is on, so a click during a shoot cannot kill a real server.
#
# Agent states are herdr's own: `blocked` means it recognised an approval or
# question on screen, so that agent is waiting on you. `done` is idle after
# background work you have not looked at yet - the tab goes back to `idle` the
# moment it is focused. Those two are the ones worth noticing.
#
# Every value below the session name comes from a snapshot: workspace labels
# are directory names, agent titles are whatever an agent wrote there. They
# are printed as JSON strings and drawn as plain text, never handed to a
# shell.

set -euo pipefail
INHERITED_UMASK=$(umask)
readonly INHERITED_UMASK
umask 077

readonly APP_ID=org.omarchy.herdr
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-herdr"
readonly DEMO_FILE="$CACHE_DIR/demo"
# Empty when this script arrived on stdin (`bash -s` on a remote host), which
# is the one place it never needs to send itself anywhere.
SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]:-}" 2>/dev/null || true)"
readonly SCRIPT
# Empty means this machine; otherwise an ssh host every action is run against.
HOST=""

die() {
  printf '{"ok":false,"error":%s,"sessions":[]}\n' "$(json_string "$1")"
  exit 0
}

# JSON-encode with jq, so a session name or window title with a quote, a
# backslash or a newline in it cannot break the object the panel parses.
# What another process is allowed to hand this script before anything reads
# it. Everything below arrives from herdr's own servers, from hyprctl, or from
# a session.json on disk, and none of those has a size this script controls.
# A server that is wedged, a session file somebody grew by accident, or simply
# more sessions than anyone meant to keep: the widget polls this every few
# seconds from a shell that never restarts, so "the other side decides how much
# memory this costs" is the wrong default even when the number never bites.
SESSIONS_BYTE_CAP=$((2 * 1024 * 1024))
SNAPSHOT_BYTE_CAP=$((2 * 1024 * 1024))
WINDOWS_BYTE_CAP=$((4 * 1024 * 1024))
SESSION_FILE_CAP=$((1 * 1024 * 1024))
# The assembled object, which is the one bound that covers a hundred sessions
# each just under their own ceiling.
TOTAL_BYTE_CAP=$((8 * 1024 * 1024))
SESSION_COUNT_CAP=200
AGENT_COUNT_CAP=500
LIST_BUDGET=6
SNAPSHOT_JOBS=4
PROC=${HERDR_TEST_PROC:-/proc}

RUN_DIR="" ; JOB_PIDS=()
run_dir_init() {               # idempotent; called by cmd_list and cmd_list_remote
  [[ -n $RUN_DIR ]] && return 0
  local base=${XDG_RUNTIME_DIR:-/tmp}
  RUN_DIR=$(umask 077; mktemp -d "$base/nixarchy-herdr.XXXXXX") || return 1
  trap run_dir_cleanup EXIT
  trap 'exit 143' TERM INT HUP   # exit runs the EXIT trap once
}
# timeout puts itself in its own process group, so a job's children are found
# through the process tree rather than signalled as a group.
kill_tree() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$child"; done
  kill -TERM "$1" 2>/dev/null || true
}
run_dir_cleanup() {
  local p
  # ${a[@]+...}: bash 4.3 treats an empty array as unset under set -u.
  for p in ${JOB_PIDS[@]+"${JOB_PIDS[@]}"}; do kill_tree "$p"; done
  for p in ${JOB_PIDS[@]+"${JOB_PIDS[@]}"}; do wait "$p" 2>/dev/null || true; done
  [[ -n $RUN_DIR ]] && rm -rf -- "$RUN_DIR"
}

# Whether a read came back at its ceiling, which means there was more to come.
# Callers pipe through `head -c cap+1`, so that one extra byte is the evidence.
#
# Measured rather than read off an exit status on purpose: under `set -o
# pipefail` a `head` that closes the pipe early hands the producer a SIGPIPE
# and makes the whole pipeline non-zero on a perfectly good read, and under
# `set -e` that would take the script down with it.
over_byte_cap() {
  local LC_ALL=C
  [ "$(printf '%s' "$1" | wc -c)" -gt "$2" ]
}

json_string() {
  printf '%s' "${1-}" | jq -Rs .
}

# Session names come from `herdr session list`, but they also arrive back as
# an argument from the panel, so they are checked before they reach a command
# line. A name shaped like anything else means the other side is not what we
# think it is: refuse it rather than tidy it up.
valid_session_name() {
  [[ "${1-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

# Pane ids are herdr's own - "w1:p2" - and come back from the panel the same
# way session names do, so they get the same treatment: checked for shape
# before they reach a command line, refused rather than repaired.
valid_pane_id() {
  [[ "${1-}" =~ ^[A-Za-z0-9_-]{1,32}:[A-Za-z0-9_-]{1,32}$ ]]
}

# A directory someone else can write to is a directory that can hand this
# script a symlink on the name it is about to write. Refuse rather than repair
# what is not ours. Only the directory itself is repaired: whatever else is in
# it is not this script's to delete or re-mode, and the one file it writes
# there sets its own mode.
private_dir() {
  local dir="$1" owner
  mkdir -p -- "$dir" 2>/dev/null
  [[ -d $dir && ! -L $dir ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ $owner == "$(id -u)" ]] || return 1
  chmod 700 -- "$dir" 2>/dev/null || return 1
}

readable_file() {
  [[ -f "$1" && ! -L "$1" ]]
}

# Host names come from herdr.json or a window's command line and reach ssh as
# its destination, so they get the same shape check as session names.
valid_host() {
  [[ "${1-}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$ ]]
}

# The only way anything reaches another machine. ssh joins its arguments into
# one remote command line, so callers pass a single string built with
# `printf %q`. BatchMode means a missing key fails instead of prompting inside
# a shell that has no terminal, and the control socket keeps a 3s poll to one
# handshake a minute. A second argument raises the 8s ceiling for the one
# call that waits on an agent.
ssh_options() {
  # Nothing is forwarded, whatever ~/.ssh/config says for that host: the
  # remote side runs this script and herdr, and needs neither the agent, the
  # display nor a port, nor a local command run on connect.
  SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=4
            -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes
            -o PermitLocalCommand=no)
  if [[ -n ${XDG_RUNTIME_DIR-} && -d ${XDG_RUNTIME_DIR-} ]]; then
    SSH_OPTS+=(-o ControlMaster=auto -o ControlPersist=60
               -o "ControlPath=$XDG_RUNTIME_DIR/nixarchy-herdr-%C")
  fi
}

bounded() {
  local s=$1; shift
  timeout -k 1 "$s" "$@"
}

timed_out() { [[ $1 == 124 || $1 == 137 ]]; }

ssh_run() {
  local -a SSH_OPTS
  ssh_options
  bounded "${2:-8}" ssh "${SSH_OPTS[@]}" -- "$HOST" "$1"
}

# A herdr started from inside a herdr pane refuses to run ("nested herdr is
# disabled"), so anything launched here drops the variables herdr sets.
without_herdr_env() {
  local -a unset=()
  local var
  for var in ${!HERDR_@}; do unset+=(-u "$var"); done
  env "${unset[@]}" "$@"
}

demo_on() {
  readable_file "$DEMO_FILE"
}

cmd_demo() {
  case "${1-}" in
    on)
      private_dir "$CACHE_DIR" || die "could not use the cache directory"
      : > "$DEMO_FILE"
      chmod 600 -- "$DEMO_FILE" 2>/dev/null || true
      printf '{"ok":true,"demo":true}\n'
      ;;
    off)
      rm -f -- "$DEMO_FILE"
      printf '{"ok":true,"demo":false}\n'
      ;;
    *) die "demo takes on or off" ;;
  esac
}

# Invented, but modelled on real work rather than made into a joke: a session
# waiting on an approval, one that finished while nobody was looking, one still
# going, and one whose server has been left behind.
demo_list() {
  cat <<'DEMO'
{"ok":true,"error":"","sessions":[
{"name":"default","isDefault":true,"running":true,"readable":true,"version":"0.8.2","agents":2,"working":1,"blocked":0,"idle":1,"done":0,"workspaces":2,"projects":["checkout-service","design-tokens"],"agentList":[{"title":"Rewrite the receipt formatter","status":"working","pane":"w1:p1","tab":"Receipts","seq":11},{"title":"Token names for the new palette","status":"idle","pane":"w2:p1","tab":"Palette","seq":9}],"windowAddress":"0x1"},
{"name":"3","isDefault":false,"running":true,"readable":true,"version":"0.8.2","agents":1,"working":0,"blocked":1,"idle":0,"done":0,"workspaces":1,"projects":["billing-api"],"agentList":[{"title":"Drop the legacy invoice table","status":"blocked","pane":"w1:p1","tab":"Migration","seq":14}],"windowAddress":"0x2"},
{"name":"5","isDefault":false,"running":true,"readable":true,"version":"0.8.2","agents":2,"working":0,"blocked":0,"idle":0,"done":2,"workspaces":1,"projects":["docs-site"],"agentList":[{"title":"Upgrade the search index","status":"done","pane":"w1:p1","tab":"Search","seq":12},{"title":"Fix the broken anchor links","status":"done","pane":"w1:p2","tab":"Anchors","seq":13}],"windowAddress":""},
{"name":"9","isDefault":false,"running":false,"readable":false,"version":"","agents":0,"working":0,"blocked":0,"idle":0,"done":0,"workspaces":0,"projects":[],"agentList":[],"windowAddress":""}
],"running":3,"agents":5,"blocked":1,"done":2,"working":1}
DEMO
}

require_tools() {
  command -v jq >/dev/null 2>&1 || die "jq is not installed"
  case ${1-} in
    app-*) command -v hc >/dev/null 2>&1 || die "could not read herdr-core" ;;
    list) return 0 ;;
    *) command -v herdr >/dev/null 2>&1 || die "herdr is not installed" ;;
  esac
}

valid_hc_address() {
  [[ ${1-} =~ ^([A-Za-z0-9][A-Za-z0-9._-]{0,31}/)?t[0-9a-z]{1,9}$ ]]
}

app_snapshot() {
  run_dir_init || die "could not make a temporary directory"
  mkfifo "$RUN_DIR/hc-events" || die "could not read herdr-core"
  bounded 3 hc events --json 2>/dev/null > "$RUN_DIR/hc-events" &
  local producer=$! snapshot
  JOB_PIDS+=("$producer")
  snapshot=$(head -c "$((TOTAL_BYTE_CAP + 1))" < "$RUN_DIR/hc-events" | head -n 1) || true
  kill_tree "$producer"
  wait "$producer" 2>/dev/null || true
  JOB_PIDS=()
  rm -f -- "$RUN_DIR/hc-events"
  if [[ -z $snapshot ]] || over_byte_cap "$snapshot" "$TOTAL_BYTE_CAP" ||
    ! printf '%s' "$snapshot" | jq -e '(.terminals | type) == "array"' >/dev/null 2>&1; then
    die "could not read herdr-core"
  fi
  printf '%s' "$snapshot" > "$RUN_DIR/hc-snapshot.json"
}

app_window_status() {
  local out rc=0
  out=$(bounded 1 herdr-app ls 2> "$RUN_DIR/app-error" |
    head -c "$((SESSION_FILE_CAP + 1))"; exit "${PIPESTATUS[0]}") || rc=$?
  if (( rc == 0 )) && ! over_byte_cap "$out" "$SESSION_FILE_CAP" &&
    printf '%s' "$out" | jq -e '(.spaces | type) == "array"' >/dev/null 2>&1; then
    printf '%s' "$out" > "$RUN_DIR/app-ls.json"
    printf 'true' > "$RUN_DIR/window-open.json"
  elif grep -q 'Connection refused' "$RUN_DIR/app-error"; then
    printf 'false' > "$RUN_DIR/window-open.json"
  else
    printf 'null' > "$RUN_DIR/window-open.json"
  fi
}

app_attention() {
  local file="$HOME/.config/herdr-app/view.json" out
  if readable_file "$file"; then
    out=$(head -c "$((SESSION_FILE_CAP + 1))" -- "$file" 2>/dev/null) || true
    if ! over_byte_cap "$out" "$SESSION_FILE_CAP" &&
      printf '%s' "$out" | jq -e '(.attention | type) == "object"' >/dev/null 2>&1; then
      printf '%s' "$out" > "$RUN_DIR/attention.json"
      return
    fi
  fi
  printf '{"attention":{}}' > "$RUN_DIR/attention.json"
}

app_merge_jq=$(cat <<'JQ'
  def machine: (.address | split("/") | if length > 1 then .[0] else "" end);
  def parent_addr: if .parent == null then null
    elif (.parent | contains("/")) then .parent
    elif machine == "" then .parent else "\(machine)/\(.parent)" end;
  def lineage($byaddr):
    reduce range(16) as $hop ([.];
      if .[-1].parentAddr == null or $byaddr[.[-1].parentAddr] == null
      then . else . + [$byaddr[.[-1].parentAddr]] end);
  ($appIn[0].spaces // [] | [ .[] as $s | $s.tabs[]?.terminals[]? |
    {key: (if $s.machine == null then "" else "\($s.machine)/" end) + .terminal,
     value: .status}] | from_entries) as $appStatus
  | ($attentionIn[0].attention // {}) as $attention
  | ($windowIn[0]) as $windowOpen
  | [.terminals[] | . + {machine: machine, liveness: .state,
      state: (.status.state // null), parentAddr: parent_addr}] as $all
  | ($all | map({key: .address, value: .}) | from_entries) as $byaddr
  | ($all | map(. + {spaceId:
      ([lineage($byaddr)[] | .labels["herdr.space"] // empty][0] // "_background")})) as $withSpace
  | [$withSpace[] | select(.liveness == "live" and .state != null)
    | . as $agent
    | ($all | [ .[] | select(.liveness == "live" and .address != $agent.address)
        | . as $candidate
        | ($candidate | lineage($byaddr)) as $chain
        | ($chain | map(.address) | index($agent.address)) as $index
        | select($index != null and
                 ([$chain[0:$index][] | .die_with_parent] | all))
        | {address, title}] | sort_by(.address)) as $cascade
    | . + {cascade: $cascade, cascadeKey: ($cascade | map(.address) | join(","))}
    | . + {displayStatus:
      (if $windowOpen == true and $appStatus[.address] != null then $appStatus[.address]
       elif .status.state == "done" and $attention[.address].word == "done" and
            $attention[.address].seen == true then "idle"
       else .status.state end)}] as $agents
  | ($agents | group_by([.machine, .spaceId]) | map(
      . as $group | ($group[0]) as $first
      | ($group | sort_by(.address) | .[0:$agentCap] | map(
          (.labels.where // "") as $where
          | {title: (if (.title // "") != "" then .title
              elif (.argv[0] // "") != "" then (.argv[0] | split("/") | last)
              else "untitled agent" end),
             status: .displayStatus, kind: .status.kind, pane: .address,
             tab: (if ($where | contains(" / ")) then ($where | split(" / ") | last) else "" end),
             seq: .status_ms, cascade, cascadeKey})) as $shown
      | {kind:"app", name: (if $first.spaceId == "_background" then "background"
          else (($first.labels.where // "") | if contains(" / ") then split(" / ")[:-1] | join(" / ") else "space" end) end),
         host: $first.machine, spaceId: $first.spaceId, running:true, readable:true,
         stale:false, agents: ($shown | length),
         blocked: ([$shown[] | select(.status == "blocked")] | length),
         done: ([$shown[] | select(.status == "done")] | length),
         working: ([$shown[] | select(.status == "working")] | length),
         hiddenAgents: (($group | length) - ($shown | length)),
         agentList:$shown, projects:[], windowAddress:""}))
  | if $remote then . else map(select(.host == "")) end as $sessions
  | {ok:true, error:"", sessions:$sessions, windowOpen:$windowOpen,
     machines: (if $remote then ($machinesIn[0].machines // []) else [] end)}
JQ
)

cmd_app_list() {
  local remote=false machines='{"machines":[]}' job out
  [[ ${1-} == --remote ]] && remote=true
  app_snapshot
  printf '{"spaces":[]}' > "$RUN_DIR/app-ls.json"
  app_window_status & job=$!
  JOB_PIDS+=("$job")
  app_attention
  wait "$job" || true
  JOB_PIDS=()
  if [[ $remote == true ]]; then
    out=$(bounded 2 hc machine ls --json 2>/dev/null |
      head -c "$((SESSION_FILE_CAP + 1))"; exit "${PIPESTATUS[0]}") || true
    if ! over_byte_cap "$out" "$SESSION_FILE_CAP" &&
      printf '%s' "$out" | jq -e '(.machines | type) == "array"' >/dev/null 2>&1; then
      machines=$out
    fi
  fi
  printf '%s' "$machines" > "$RUN_DIR/machines.json"
  out=$(jq -c --argjson remote "$remote" --argjson agentCap "$AGENT_COUNT_CAP" \
    --slurpfile appIn "$RUN_DIR/app-ls.json" \
    --slurpfile attentionIn "$RUN_DIR/attention.json" \
    --slurpfile windowIn "$RUN_DIR/window-open.json" \
    --slurpfile machinesIn "$RUN_DIR/machines.json" \
    "$app_merge_jq" "$RUN_DIR/hc-snapshot.json" 2>/dev/null) || die "could not read herdr-core"
  over_byte_cap "$out" "$TOTAL_BYTE_CAP" && die "could not read herdr-core"
  printf '%s\n' "$out"
}

# ---------------------------------------------------------------- windows

# One step up the process tree. Read from /proc rather than kept in an array
# of every process on the machine: only the handful of herdr clients are ever
# walked, and each walk is a few reads.
#
# The comm field is in brackets and can hold spaces, so the line is cut after
# the closing bracket before splitting: what follows is state, then ppid.
parent_pid() {
  local line rest
  { read -r line < "$PROC/$1/stat"; } 2>/dev/null || return 1
  rest=${line##*") "}
  # shellcheck disable=SC2086
  set -- $rest
  [[ ${2-} =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$2"
}

# Which Hyprland window is showing which session.
#
# The launcher puts `herdr --session <name>` on the terminal's own command
# line, so most windows are recognised from that alone. A herdr started by
# hand inside an existing terminal is not, so the client processes are walked
# up to their window instead: a process named exactly `herdr` is the client,
# `herdr server` is not.
#
# Prints "host/session<TAB>address<TAB>workspace" per line, host empty for
# this machine. Sessions without a
# window are absent.
window_map() {
  command -v hyprctl >/dev/null 2>&1 || return 0

  local clients
  clients=$(bounded 2 hyprctl clients -j 2>/dev/null |
    head -c "$((WINDOWS_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || return 0
  [[ -n $clients ]] || return 0
  # Window titles are set by whatever is running in them. Without a ceiling a
  # single window could decide how much this costs.
  over_byte_cap "$clients" "$WINDOWS_BYTE_CAP" && return 0

  # Only a process that owns exactly one window is matched. A terminal that
  # serves every window from one process (ghostty, footclient) cannot say which
  # of them is showing herdr, and focusing the wrong one is worse than opening
  # a new one. Kitty and foot, as the launcher starts them, are one process per
  # window.
  declare -A window_of_pid=()
  local pid address workspace
  while IFS=$'\t' read -r pid address workspace; do
    [[ -n $pid && -n $address ]] || continue
    window_of_pid[$pid]=$address$'\t'$workspace
  done < <(printf '%s' "$clients" |
    jq -r '[.[] | select(.pid > 0)] | group_by(.pid) | map(select(length == 1) | .[0])
           | .[] | "\(.pid)\t\(.address)\t\(.workspace.name // "")"' 2>/dev/null)

  ((${#window_of_pid[@]})) || return 0

  # Only the herdr processes are read in. Reading every command line on the
  # machine into an array cost more than every other step in this script put
  # together, and all but a handful of those lines never mention herdr.
  # pgrep rather than ps: it reads the whole of /proc/<pid>/cmdline, where ps
  # cuts the line at COLUMNS and can drop the --session off the end.
  declare -A args_of=()
  local processes
  processes=$(bounded 2 pgrep -af herdr 2>/dev/null) || return 0
  while read -r pid args; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    args_of[$pid]=$args
  done <<< "$processes"

  declare -A emitted=()

  emit() {
    local session="$1" window="$2"
    [[ -n ${emitted[$session]-} ]] && return 0
    emitted[$session]=1
    printf '%s\t%s\n' "$session" "$window"
  }

  # Read "host/session" out of a command line that runs herdr, host empty for
  # this machine. The answer comes back in $found_key rather than on stdout: a
  # command substitution forks a subshell, and this is called once per process
  # on the machine. Through a `$()` it cost a third of a second per refresh.
  #
  # Keyed on the host as well as the name, or a `herdr --remote razer
  # --session X` window would be taken for a local session called X.
  local found_key=""
  session_in_args() {
    found_key=""
    local -a words
    read -r -a words <<<"${1-}"
    local i j name host
    for ((i = 0; i < ${#words[@]}; i++)); do
      # The command itself, by name or from a bin directory; a file that only
      # happens to be called herdr, like `vim ~/src/herdr`, is not.
      [[ ${words[i]} == herdr || ${words[i]} == */bin/herdr ]] || continue
      name=default
      host=""
      for ((j = i + 1; j < ${#words[@]}; j++)); do
        case ${words[j]} in
          --session) name=${words[j + 1]-}; ((j += 1)) ;;
          --session=*) name=${words[j]#*=} ;;
          --remote) host=${words[j + 1]-}; host=${host##*@}; ((j += 1)) ;;
          --remote=*) host=${words[j]#*=}; host=${host##*@} ;;
          -*) ;;
          session)
            [[ ${words[j + 1]-} == attach ]] || return 1
            name=${words[j + 2]-}
            break ;;
          *) return 1 ;;
        esac
      done
      valid_session_name "$name" || return 1
      [[ -z $host ]] || valid_host "$host" || return 1
      found_key=$host/$name
      return 0
    done
    return 1
  }

  # The terminal's own command line first: that is how the launcher starts one.
  for pid in "${!window_of_pid[@]}"; do
    session_in_args "${args_of[$pid]-}" || continue
    emit "$found_key" "${window_of_pid[$pid]}"
  done

  # Then anything started by hand, walked up from the client to its window.
  local ancestor hops
  for pid in "${!args_of[@]}"; do
    session_in_args "${args_of[$pid]}" || continue
    ancestor=$pid
    for ((hops = 0; hops < 12; hops++)); do
      ancestor=$(parent_pid "$ancestor") || break
      [[ -n $ancestor && $ancestor != 0 && $ancestor != 1 ]] || break
      if [[ -n ${window_of_pid[$ancestor]-} ]]; then
        emit "$found_key" "${window_of_pid[$ancestor]}"
        break
      fi
    done
  done
}

# ---------------------------------------------------------------- listing

# One session's agents and workspaces, from its own server. `--session` is
# left off for the default one: passing it by name would address a *named*
# session that happens to be called "default", which is a different server.
snapshot_for() {
  local name="$1" is_default="$2" limit="$3"
  local out rc=0
  # A failed or timed-out read has no snapshot. The extra byte reveals an
  # oversized answer even when head closes the pipe on the server.
  if [[ $is_default == true ]]; then
    out=$(bounded "$limit" herdr api snapshot 2>/dev/null |
      head -c "$((SNAPSHOT_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || rc=$?
  else
    out=$(bounded "$limit" herdr --session "$name" api snapshot 2>/dev/null |
      head -c "$((SNAPSHOT_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || rc=$?
  fi
  (( rc == 0 )) || return 1
  [[ -n $out ]] || return 1
  # One oversized server is unreadable rather than allowed to take the list down.
  over_byte_cap "$out" "$SNAPSHOT_BYTE_CAP" && return 1
  printf '%s' "$out"
}

cmd_list() {
  local LC_ALL=C sessions_json start=$SECONDS
  run_dir_init || die "could not make a temporary directory"
  # Bounded in time as well as size: an empty answer is "could not reach".
  sessions_json=$(bounded 4 herdr session list --json 2>/dev/null | head -c "$((SESSIONS_BYTE_CAP + 1))") || true
  [[ -n $sessions_json ]] || die "could not reach herdr"
  over_byte_cap "$sessions_json" "$SESSIONS_BYTE_CAP" && die "session list too large to read safely"

  # --no-windows is how a remote host is asked: its windows are not ours, the
  # caller pairs them against this machine's instead.
  local windows=""
  [[ ${1-} == --no-windows ]] || windows=$(window_map || true)

  # Snapshots are projected in bounded jobs, then merged by session name.
  # A session that is not running has no server to ask, but it has not
  # forgotten anything either: herdr writes the layout to session.json, and
  # that file still names the workspaces and the directory each one was opened
  # in. Reading it is what makes a stopped row say what it is holding rather
  # than only that it is down - the difference between a session worth starting
  # back up and a name left over from an afternoon.
  local saved='' ghosts='' name is_default running dir labels remaining limit active=0
  while IFS=$'\t' read -r name is_default running dir; do
    [[ -n $name ]] || continue
    valid_session_name "$name" || continue

    if [[ $running == true ]]; then
      remaining=$((LIST_BUDGET - (SECONDS - start)))
      (( remaining >= 2 )) || continue
      while (( active >= SNAPSHOT_JOBS )); do
        wait -n || true
        mapfile -t JOB_PIDS < <(jobs -pr)
        active=${#JOB_PIDS[@]}
      done
      remaining=$((LIST_BUDGET - (SECONDS - start)))
      (( remaining >= 2 )) || continue
      limit=$((remaining - 1))
      (( limit <= 2 )) || limit=2
      (
        snapshot_for "$name" "$is_default" "$limit" |
          jq -ec --arg name "$name" '
            .result.snapshot
            | select(type == "object" and (.agents | type == "array")
                     and (.workspaces | type == "array") and (.tabs | type == "array"))
            | select(all(.agents[]; type == "object")
                     and all(.workspaces[]; type == "object") and all(.tabs[]; type == "object"))
            | {($name): {
                version: (.version // "" | tostring),
                agents: [.agents[] | {
                  title: (.terminal_title_stripped // .terminal_title // "" | tostring),
                  status: (.agent_status // "unknown" | tostring),
                  pane: (.pane_id // "" | tostring),
                  workspace_id: (.workspace_id // "" | tostring),
                  tab_id: (.tab_id // "" | tostring),
                  seq: (.state_change_seq | tonumber? // 0)
                }],
                workspaces: [.workspaces[] | {
                  workspace_id: (.workspace_id // "" | tostring),
                  label: (.label // "" | tostring)
                }],
                tabs: [.tabs[] | {
                  tab_id: (.tab_id // "" | tostring),
                  label: (.label // "" | tostring),
                  number: (.number // "" | tostring)
                }]
              }}' > "$RUN_DIR/snap.$name.tmp" 2>/dev/null &&
          mv -- "$RUN_DIR/snap.$name.tmp" "$RUN_DIR/snap.$name.json"
      ) &
      JOB_PIDS+=($!)
      active=$((active + 1))
      continue
    fi

    # `herdr --remote` leaves a local directory under the remote session's
    # name holding nothing but herdr-client.log. It is not a session: there is
    # no layout to restore, and it would shadow a real one called the same.
    if ! readable_file "$dir/session.json"; then
      ghosts+="$name"$'\n'
      continue
    fi
    # The label herdr shows is the name a workspace was given, and the last
    # part of the directory it was opened in otherwise - the same two, in the
    # same order, that a running snapshot resolves to its label.
    # Read through a ceiling rather than handed to jq whole: this file is on
    # disk and nothing here decided how big it is.
    over_byte_cap "$(head -c "$((SESSION_FILE_CAP + 1))" -- "$dir/session.json" 2>/dev/null || true)" \
      "$SESSION_FILE_CAP" && continue
    labels=$(jq -c --arg home "$HOME" '[.workspaces[]?
                     | (.custom_name
                        // (if (.identity_cwd // "") == $home then "~"
                            else (.identity_cwd // "" | split("/") | last) end))
                     | select(. != null and . != "")]
                    | unique' -- "$dir/session.json" 2>/dev/null) || continue
    [[ -n $labels ]] || continue
    saved+="${saved:+,}\"$name\":$labels"
  done < <(printf '%s' "$sessions_json" |
    jq -r '.sessions[]? | "\(.name)\t\(.default // false)\t\(.running // false)\t\(.session_dir // "")"')
  local job
  for job in ${JOB_PIDS[@]+"${JOB_PIDS[@]}"}; do wait "$job" || true; done
  JOB_PIDS=()
  saved="{$saved}"
  printf '%s' "$saved" | jq -e . >/dev/null 2>&1 || saved="{}"
  local -a files=()
  local had_nullglob=0
  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob
  files=("$RUN_DIR"/snap.*.json)
  (( had_nullglob )) || shopt -u nullglob

  # The big inputs go in through pipes, not arguments: Linux refuses any one
  # argument over 128 KB, and a single busy server's snapshot passes that.
  local output
  output=$(printf '%s' "$sessions_json" | jq -c \
    --slurpfile snapshotsIn <(if ((${#files[@]})); then cat "${files[@]}"; else cat /dev/null; fi) \
    --slurpfile savedIn <(printf '%s' "$saved") \
    --argjson agentCap "$AGENT_COUNT_CAP" \
    --argjson sessionCap "$SESSION_COUNT_CAP" \
    --rawfile windows <(printf '%s' "$windows") \
    --rawfile ghosts <(printf '%s' "$ghosts") '
    ($snapshotsIn | add // {}) as $snapshots | ($savedIn[0]) as $saved
    | ($windows | split("\n") | map(select(length > 0) | split("\t"))
      | map({key: .[0], value: .[1]}) | from_entries) as $win
    | ($ghosts | split("\n") | map(select(length > 0))) as $ghostNames
    | [.sessions[]?
       | select(.name as $n | $ghostNames | index($n) | not)
       | .name as $name
       | ($snapshots[$name] // {}) as $snap
       | ($snap.agents // []) as $agents
       # Workspace labels live on the workspace, the agent only carries the id
       # it sits in, so they are joined here rather than in the panel: one
       # place turns what herdr says into what gets drawn.
       | (($snap.workspaces // [])
          | map({key: (.workspace_id // ""), value: (.label // "")})
          | from_entries) as $wslabels
       # Tab names are joined the same way. A tab nobody named comes back
       # either with its number as the label ("1") or with the title herdr gives it,
       # "<number> · <what runs in it>". Neither is a name worth printing
       # after every workspace, so both join as empty.
       | (($snap.tabs // [])
          | map({key: (.tab_id // ""),
                 value: ((.label // "") as $l
                         | if $l == ((.number // "") | tostring)
                              or ($l | test("^[0-9]+ · "))
                           then "" else $l end)})
          | from_entries) as $tablabels
       | ($agents
          | map({title: (.title | if . == "" then "untitled agent" else . end),
                 status, pane,
                 workspace: ($wslabels[.workspace_id] // ""),
                 tab: ($tablabels[.tab_id] // ""), seq})
          | sort_by(if   .status == "blocked" then 0
                    elif .status == "done"    then 1
                    elif .status == "working" then 2
                    elif .status == "idle"    then 3
                    else 4 end)
          | .[0:$agentCap]) as $agentList
       | {
           name: $name,
           host: "",
           isDefault: (.default // false),
           running: (.running // false),
           readable: ((.running // false) and ($snapshots | has($name))),
           version: ($snap.version // ""),
           agents: ($agentList | length),
           hiddenAgents: (($agents | length) - ($agentList | length)),
           working: ([$agentList[] | select(.status == "working")] | length),
           blocked: ([$agentList[] | select(.status == "blocked")] | length),
           idle:    ([$agentList[] | select(.status == "idle")] | length),
           done:    ([$agentList[] | select(.status == "done")] | length),
           workspaces: (($snap.workspaces // []) | length),
           agentList: $agentList,
           projects: (if (.running // false)
                      then (($snap.workspaces // []) | map(.label // "")
                            | map(select(length > 0)) | unique)
                      else ($saved[$name] // []) end),
           windowAddress: ($win["/" + $name] // "")
         }]
    | sort_by([(if .isDefault then 0 else 1 end),
               (if .running then 0 else 1 end),
               (.name | ascii_downcase)])
    | . as $all | .[0:$sessionCap] as $shown
    | {ok: true,
       error: "",
       sessions: $shown,
       hidden: (($all | length) - ($shown | length)),
       running: ([$shown[] | select(.running)] | length),
       agents: ([$shown[] | .agents] | add // 0),
       blocked: ([$shown[] | .blocked] | add // 0),
       done: ([$shown[] | .done] | add // 0),
       working: ([$shown[] | .working] | add // 0)}
  ' 2>/dev/null) || die "unexpected output from herdr"
  over_byte_cap "$output" "$TOTAL_BYTE_CAP" && die "session list too large to show"
  printf '%s\n' "$output"
}

# Another machine's sessions: this script runs there from stdin, so nothing is
# installed on it, and its answer is tagged with the host and paired against
# the windows on this machine. Everything that comes back is treated the same
# as a local server's output: capped, parsed, never executed.
cmd_list_remote() {
  local out windows pid rc=0
  local -a SSH_OPTS
  run_dir_init || die "could not make a temporary directory"
  ssh_options
  (
    ulimit -f "$((TOTAL_BYTE_CAP / 1024 + 1))" || exit 1
    exec timeout -k 1 8 ssh "${SSH_OPTS[@]}" -- "$HOST" "bash -s -- list --no-windows"
  ) < "$SCRIPT" > "$RUN_DIR/remote.out" 2>/dev/null &
  pid=$!
  JOB_PIDS+=("$pid")
  wait "$pid" || rc=$?
  JOB_PIDS=()
  out=$(head -c "$((TOTAL_BYTE_CAP + 1))" "$RUN_DIR/remote.out") || true
  [[ -n $out ]] || die "$HOST is unreachable"
  over_byte_cap "$out" "$TOTAL_BYTE_CAP" && die "$HOST answered with too much to read safely"
  (( rc == 0 )) || die "$HOST is unreachable"
  windows=$(window_map || true)
  printf '%s' "$out" | jq -c --arg host "$HOST" --rawfile windows <(printf '%s' "$windows") '
    ($windows | split("\n") | map(select(length > 0) | split("\t"))
      | map({key: .[0], value: .[1]}) | from_entries) as $win
    | .sessions |= map(.host = $host
                       | .windowAddress = ($win[$host + "/" + .name] // ""))
  ' 2>/dev/null || die "unexpected output from $HOST"
}

# ------------------------------------------------------------- open a session

# Bring up the window showing a session, or start one. Returns 0 once
# something has been done, 1 when no terminal could be started.
show_session() {
  local name="$1" dir="${2:-$HOME}"

  local address workspace
  IFS=$'\t' read -r address workspace < <(
    window_map | awk -F'\t' -v want="$HOST/$name" '$1 == want { print $2 "\t" $3; exit }' || true)

  # Both values are spliced into a Lua expression, so they are checked for
  # shape first rather than escaped. A window address is hex; a workspace name
  # is a number, a name, or "special:<name>". Anything else means the window
  # is not what we think it is, and focusing is not worth guessing at.
  if [[ $address =~ ^0x[0-9a-fA-F]+$ ]]; then
    # A window on another workspace stays hidden however hard it is focused:
    # focus picks the window, it does not bring its workspace into view. So
    # switch first, then focus - which also lands on the right monitor when
    # the workspace lives on the other screen.
    if [[ $workspace =~ ^(special:)?[A-Za-z0-9_-]{1,32}$ ]]; then
      bounded 2 hyprctl dispatch "hl.dsp.focus({ workspace = '$workspace' })" >/dev/null 2>&1 || return 3
    fi
    # Quattro's hyprctl parses its argument as Lua, so `dispatch focuswindow`
    # is a syntax error now. The address is single-quoted inside the Lua call.
    bounded 2 hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null 2>&1 || return 3
    return 0
  fi

  # No window: open one. A numbered session is named after the Hyprland
  # workspace it belongs to, so it is opened there rather than on top of
  # whatever is in front of you - otherwise "Workspace 4" would land on
  # workspace 7 and the name would stop meaning anything. Local sessions only:
  # a remote "4" names a workspace on the other machine.
  if [[ -z $HOST && $name =~ ^[0-9]{1,3}$ ]]; then
    bounded 2 hyprctl dispatch "hl.dsp.focus({ workspace = '$name' })" >/dev/null 2>&1 || return 3
  fi

  # `herdr --session <name>` attaches to the server that is already running
  # under that name and only starts one when there is none, so the same
  # command covers a running session with no window and a stopped one. The
  # session keeps its own state, so the directory only matters the very first
  # time a name is used.
  # `--remote` attaches through ssh and, like the local form, starts the
  # server when it is not running.
  local -a herdr_cmd=(herdr)
  [[ -z $HOST ]] || herdr_cmd+=(--remote "$HOST")
  [[ $name == default ]] || herdr_cmd+=(--session "$name")

  # The desktop's own terminal through xdg-terminal-exec, which passes the app
  # id on through the terminal's X-TerminalArgAppId (kitty: --class); window
  # rules key off it. Foot by name is the fallback for a machine without it.
  local -a launch=()
  if command -v uwsm-app >/dev/null 2>&1; then
    launch=(setsid uwsm-app --)
  else
    launch=(setsid)
  fi

  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    launch+=(xdg-terminal-exec "--app-id=$APP_ID" "--dir=$dir" -- "${herdr_cmd[@]}")
  elif command -v foot >/dev/null 2>&1; then
    launch+=(foot "--app-id=$APP_ID" "--working-directory=$dir" -e "${herdr_cmd[@]}")
  else
    return 1
  fi

  local pid
  # The terminal inherits the panel's umask; this script's files stay private.
  ( umask "$INHERITED_UMASK" && without_herdr_env "${launch[@]}" ) >/dev/null 2>&1 &
  pid=$!
  sleep 0.3
  if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" || return 2
  fi
  disown "$pid" 2>/dev/null || true
  return 0
}

cmd_open() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  local rc=0
  show_session "$name" || rc=$?
  case $rc in
    1) die "no terminal available" ;;
    2) die "the terminal exited at once" ;;
    3) die "could not focus the window" ;;
  esac
  printf '{"ok":true}\n'
}

# Land on one agent rather than on whatever the session was last showing.
#
# The pane is focused over the socket first, so the server has already moved
# by the time the window comes up - and it moves even when there is no window
# at all, which is what makes this work on a session that has to be opened.
# `herdr agent focus` switches workspace and tab inside the session on its
# own; the hyprctl half below is only about which window is in front of you.
cmd_focus() {
  local name="${1-}" pane="${2-}"
  valid_session_name "$name" || die "not a session name"
  valid_pane_id "$pane" || die "not a pane id"

  # No `--` before the pane id: herdr does not take one, and valid_pane_id has
  # already refused anything but two runs of letters, digits, dash and
  # underscore around a colon - so nothing here can arrive looking like an
  # option in the first place.
  local -a focus_cmd=(herdr)
  [[ $name == default ]] || focus_cmd+=(--session "$name")
  focus_cmd+=(agent focus "$pane")
  local rc=0
  if [[ -n $HOST ]]; then
    ssh_run "$(printf '%q ' "${focus_cmd[@]}")" 4 </dev/null >/dev/null 2>&1 || rc=$?
  else
    bounded 4 "${focus_cmd[@]}" >/dev/null 2>&1 || rc=$?
  fi
  timed_out "$rc" && die "timed out: focus"
  (( rc == 255 )) && [[ -n $HOST ]] && die "$HOST is unreachable"
  (( rc == 0 )) || die "herdr could not focus that pane"

  rc=0
  show_session "$name" || rc=$?
  case $rc in
    1) die "no terminal available" ;;
    2) die "the terminal exited at once" ;;
    3) die "could not focus the window" ;;
  esac
  printf '{"ok":true}\n'
}

# ------------------------------------------------------------ new session

# Whether a session of that name exists on the host this runs against,
# running or not. An unreachable host counts as "cannot tell", which refuses.
# Read herdr's complete list, including names beyond the display cap.
session_exists() {
  local json rc=0
  if [[ -n $HOST ]]; then
    json=$(ssh_run "herdr session list --json" 4 </dev/null 2>/dev/null |
      head -c "$((SESSIONS_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || rc=$?
  else
    json=$(bounded 4 herdr session list --json 2>/dev/null |
      head -c "$((SESSIONS_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || rc=$?
  fi
  timed_out "$rc" && die "timed out: checking the name"
  (( rc == 0 )) || return 2
  over_byte_cap "$json" "$SESSIONS_BYTE_CAP" && return 2
  printf '%s' "$json" | jq -e --arg name "$1" '
    (.sessions | type == "array") and any(.sessions[]; .name == $name)' >/dev/null 2>&1 || {
      printf '%s' "$json" | jq -e '.sessions | type == "array"' >/dev/null 2>&1 || return 2
      return 1
    }
}

# A new session and nothing else: a name that already exists is refused rather
# than attached to, so "new" can never quietly become "open" or restart a
# stopped session somebody meant to leave alone.
#
# Locally the terminal starts in dir, which is where herdr opens the first
# workspace. Over ssh the terminal's directory is this machine's, so the
# directory is given to the remote server as a workspace once it is up.
cmd_new() {
  local name="${1-}" dir="${2-}"
  valid_session_name "$name" || die "not a session name"
  [[ $name != default ]] || die "default already exists"
  if [[ -n $dir ]]; then
    [[ $dir == /* && $dir != *$'\n'* && ${#dir} -le 4096 ]] || die "directory must be an absolute path"
    [[ -n $HOST || -d $dir ]] || die "no such directory"
  fi

  local rc=0
  session_exists "$name" || rc=$?
  (( rc != 2 )) || die "could not read the session list"
  (( rc != 0 )) || die "a session called $name already exists"

  local launch_dir=""
  [[ -n $HOST ]] || launch_dir=$dir
  rc=0
  show_session "$name" "$launch_dir" || rc=$?
  case $rc in
    1) die "no terminal available" ;;
    2) die "the terminal exited at once" ;;
    3) die "could not focus the window" ;;
  esac

  if [[ -n $HOST && -n $dir ]]; then
    local running="" deadline=$((SECONDS + ${HERDR_TEST_NEW_DEADLINE:-30}))
    while (( deadline - SECONDS >= 8 )); do
      # Capped like the local list: the other host decides how much it sends.
      running=$(ssh_run "herdr session list --json" </dev/null 2>/dev/null |
        head -c "$((SESSIONS_BYTE_CAP + 1))" |
        jq -r --arg name "$name" '.sessions[]? | select(.name == $name) | .running' 2>/dev/null) || true
      [[ $running == true ]] && break
      (( deadline - SECONDS >= 8 )) || break
      sleep 0.5
    done
    [[ $running == true ]] || die "session started, but $HOST never reported it running"
    ssh_run "$(printf '%q ' herdr --session "$name" workspace create --cwd "$dir" --focus)" \
      </dev/null >/dev/null 2>&1 || die "session started, but the workspace in $dir was not created"
  fi
  printf '{"ok":true}\n'
}

# ----------------------------------------------------------------- prompt

# Hand an agent a short instruction and wait for it to answer.
#
# The text crosses the panel and ssh on stdin, so nothing has to be quoted and
# nothing it contains is part of a command line on the other machine. It is
# still an argument to `herdr agent prompt`, so a local process list shows it
# while the prompt waits.
#
# Waiting stops on idle, done or blocked, which are the states that want you
# back. What comes back is the agent's own screen, capped like any other
# output this script reads. Nothing is kept on disk.
cmd_prompt() {
  local name="${1-}" pane="${2-}"
  valid_session_name "$name" || die "not a session name"
  valid_pane_id "$pane" || die "not a pane id"

  local text
  text=$(head -c 16384)
  # The text is typed into the agent's terminal, so a control character in it
  # is a keystroke: an escape sequence could end a bracketed paste early, and a
  # carriage return would submit half of it. Tab and newline are kept.
  text=$(printf '%s' "$text" | tr -d '\000-\010\013-\037\177')
  [[ -n ${text//[[:space:]]/} ]] || die "nothing to send"

  local -a base=(herdr)
  [[ $name == default ]] || base+=(--session "$name")
  local -a wait_for=(--wait --until 'idle' --until 'done' --until 'blocked')

  # The wait runs as a direct child rather than inside a command
  # substitution, so a TERM from the menu (Esc, or the menu closing) reaches
  # it: `timeout` passes the signal on to herdr. In a `$(...)` it would sit in
  # a subshell the trap cannot see, and keep waiting on the agent for minutes.
  local child rc=0
  if [[ -n $HOST ]]; then
    local -a SSH_OPTS
    ssh_options
    # The remote side gets its own ceiling as well: a dropped connection does
    # not stop a command waiting there on its own.
    #
    # Nor does killing ssh here: the command on the other end never hears
    # about it. So the wait runs in the background there, and a newline is
    # written once a second while it lasts. Once this end is gone, sshd has
    # closed that stdout, the write fails, and the prompt is sent TERM, which
    # `timeout` passes on to herdr. SIGPIPE is ignored so the failed write
    # returns an error instead of killing the loop. `wait` hands back herdr's
    # own exit code. The newlines land in /dev/null on this side.
    #
    # One line, no newlines in it: `printf %q` would turn those into $'...',
    # which not every login shell on the other end reads.
    local remote
    # shellcheck disable=SC2016 # expanded by the remote bash, not here
    {
      remote='t=$(cat); timeout 300 "$@" "$t" '"${wait_for[*]}"' & p=$!; trap "" PIPE; '
      remote+='while kill -0 "$p" 2>/dev/null; do '
      remote+='printf "\n" 2>/dev/null || { kill -TERM "$p"; break; }; sleep 1; done; wait "$p"'
    }
    timeout 305 ssh "${SSH_OPTS[@]}" -- "$HOST" \
      "$(printf '%q ' bash -c "$remote" _ "${base[@]}" agent prompt "$pane")" <<<"$text" >/dev/null 2>&1 &
  else
    timeout 300 "${base[@]}" agent prompt "$pane" "$text" "${wait_for[@]}" </dev/null >/dev/null 2>&1 &
  fi
  child=$!
  trap 'kill -TERM "$child" 2>/dev/null; exit 143' TERM INT HUP
  wait "$child" || rc=$?
  trap - TERM INT HUP
  # A timed-out wait still ends in reading the screen.
  # 255 is ssh itself failing, so there is no agent to ask.
  (( rc == 255 )) && [[ -n $HOST ]] && die "$HOST is unreachable"

  # The agent's answer is capped like the screen. One cut short fails jq below
  # and counts as no status, the same as an agent that did not answer.
  local agent screen read_rc=0
  if [[ -n $HOST ]]; then
    agent=$(ssh_run "$(printf '%q ' "${base[@]}" agent get "$pane")" 4 </dev/null 2>/dev/null |
      head -c "$((SNAPSHOT_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || read_rc=$?
    timed_out "$read_rc" && die "timed out: reading the reply"
    read_rc=0
    screen=$(ssh_run "$(printf '%q ' "${base[@]}" agent read "$pane" --source recent --lines 60)" 4 \
      </dev/null 2>/dev/null | head -c "$((SNAPSHOT_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || read_rc=$?
  else
    agent=$(bounded 4 "${base[@]}" agent get "$pane" </dev/null 2>/dev/null |
      head -c "$((SNAPSHOT_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || read_rc=$?
    timed_out "$read_rc" && die "timed out: reading the reply"
    read_rc=0
    screen=$(bounded 4 "${base[@]}" agent read "$pane" --source recent --lines 60 </dev/null 2>/dev/null |
      head -c "$((SNAPSHOT_BYTE_CAP + 1))"; exit "${PIPESTATUS[0]}") || read_rc=$?
  fi
  timed_out "$read_rc" && die "timed out: reading the reply"
  over_byte_cap "$screen" "$SNAPSHOT_BYTE_CAP" && screen=$(printf '%s' "$screen" | head -c "$SNAPSHOT_BYTE_CAP") || true

  local status
  status=$(printf '%s' "$agent" | jq -r '.result.agent.agent_status // empty' 2>/dev/null) || true
  [[ -n $status ]] || [[ -n $screen ]] || die "could not reach that agent"
  # Any other exit is herdr refusing the prompt. The screen would show
  # whatever was there before, which reads as an answer when nothing was sent.
  if (( rc != 0 )) && ! timed_out "$rc"; then
    [[ $status == blocked ]] && die "the agent is waiting on a question; nothing was sent"
    die "herdr did not start the prompt (agent is ${status:-unknown})"
  fi
  if timed_out "$rc"; then status=timeout; fi
  printf '%s' "$screen" | jq -Rsc --arg status "$status" \
    '{ok: true, status: $status, output: .}'
}

# ------------------------------------------------------------ kill / delete

# Which process is serving a session. Every herdr server has the same command
# line - a bare `herdr server`, with no session name on it - so the socket it
# is listening on is the only thing that tells them apart. `ss` is what maps a
# listening unix socket back to the process holding it.
server_pid_for() {
  local socket="$1" line field pid comm rest start
  local -a fields
  [[ -n $socket ]] || return 1
  while IFS= read -r line; do
    read -r -a fields <<< "$line"
    local found=false
    for field in "${fields[@]}"; do [[ $field == "$socket" ]] && found=true; done
    [[ $found == true ]] || continue
    rest=$line
    while [[ $rest =~ pid=([0-9]+) ]]; do
      pid=${BASH_REMATCH[1]}
      rest=${rest#*pid="$pid"}
      { read -r comm < "$PROC/$pid/comm"; } 2>/dev/null || continue
      [[ $comm == herdr ]] || continue
      tr '\0' '\n' < "$PROC/$pid/cmdline" 2>/dev/null |
        awk 'NR == 2 { ok = ($0 == "server") } END { exit !ok }' || continue
      { read -r line < "$PROC/$pid/stat"; } 2>/dev/null || continue
      line=${line##*") "}
      read -r -a fields <<< "$line"
      start=${fields[19]-}
      [[ $start =~ ^[0-9]+$ ]] || continue
      printf '%s %s' "$pid" "$start"
      return 0
    done
  done < <(ss -lpxn 2>/dev/null)
  return 1
}

same_process() {
  local pid=$1 start=$2 line comm
  local -a fields
  { read -r line < "$PROC/$pid/stat"; } 2>/dev/null || return 1
  line=${line##*") "}
  read -r -a fields <<< "$line"
  [[ ${fields[19]-} == "$start" ]] || return 1
  { read -r comm < "$PROC/$pid/comm"; } 2>/dev/null || return 1
  [[ $comm == herdr ]] || return 1
  tr '\0' '\n' < "$PROC/$pid/cmdline" 2>/dev/null |
    awk 'NR == 2 { ok = ($0 == "server") } END { exit !ok }'
}

wait_gone() {
  local pid=$1 start=$2 i
  for ((i = 0; i < 10; i++)); do
    same_process "$pid" "$start" || return 0
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  return 1
}

socket_of() {
  local out rc=0
  out=$(bounded 4 herdr session list --json 2>/dev/null) || rc=$?
  timed_out "$rc" && return "$rc"
  (( rc == 0 )) || return 1
  printf '%s' "$out" | jq -r --arg name "$1" '.sessions[]? | select(.name == $name) | .socket_path // ""' 2>/dev/null
}

# How a server is ended here, and the only way. `herdr session stop` asks over
# the socket, so a server too wedged to read that socket never hears it and the
# button looks broken at exactly the moment it is needed. A signal reaches the
# process either way, so there is nothing for the tidy route to be better at.
#
# TERM first and KILL only if that was not enough: a server given the chance to
# close its sockets leaves no stale ones behind, and on a healthy server the
# first signal is all it takes. The default session is killed like any other.
cmd_kill() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"

  local pid start server socket rc=0
  socket=$(socket_of "$name") || rc=$?
  timed_out "$rc" && die "timed out: finding the server"
  (( rc == 0 )) || die "no running server for that session"
  server=$(server_pid_for "$socket") || die "no running server for that session"
  read -r pid start <<< "$server"

  # Recheck the process identity immediately before each signal.
  same_process "$pid" "$start" || { printf '{"ok":true}\n'; return 0; }
  if ! kill -TERM "$pid" 2>/dev/null; then
    same_process "$pid" "$start" && die "not allowed to stop that server"
  fi
  if ! wait_gone "$pid" "$start"; then
    same_process "$pid" "$start" || { printf '{"ok":true}\n'; return 0; }
    kill -KILL "$pid" 2>/dev/null || true
    wait_gone "$pid" "$start" || die "the server did not stop"
  fi

  printf '{"ok":true}\n'
}

cmd_delete() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  [[ $name == default ]] && die "the default session is not deleted from here"
  # No `--` before the name: herdr's argument parser does not take one, and a
  # session name has already been checked against the shape above. herdr's own
  # stderr is what it said went wrong, and it is the only thing that can tell
  # the panel why the row is still there; swallowing it reported a delete that
  # never happened.
  local err rc=0
  err=$(bounded 8 herdr session delete "$name" 2>&1 >/dev/null) || rc=$?
  timed_out "$rc" && die "timed out: delete"
  (( rc == 0 )) || die "${err:-herdr could not delete that session}"
  printf '{"ok":true}\n'
}

# kill and delete act on the machine the server lives on: the socket-to-pid
# lookup reads that machine's `ss` and /proc. So the whole action runs there,
# with this script on stdin and its (already validated) arguments quoted.
remote_action() {
  local out rc=0
  # 12 s: longer than the remote side's own 8 s limits, so its message wins.
  out=$(ssh_run "bash -s -- $(printf '%q ' "$@")" 12 < "$SCRIPT" 2>/dev/null |
    head -c 4096; exit "${PIPESTATUS[0]}") || rc=$?
  timed_out "$rc" && die "timed out: $1 on $HOST"
  (( rc == 0 )) || die "$HOST is unreachable"
  [[ -n $out ]] || die "$HOST is unreachable"
  printf '%s\n' "$out"
}

# ------------------------------------------------------------------- main

# `--host H` first, checked before anything is built from it.
if [[ ${1-} == --host ]]; then
  valid_host "${2-}" || die "not a host name"
  HOST=$2
  shift 2
  [[ -n $SCRIPT ]] || die "cannot reach another host from a script read on stdin"
fi

require_tools "${1:-list}"

case "${1:-list}" in
  list)
    shift || true
    if demo_on; then
      if [[ -n $HOST ]]; then printf '{"ok":true,"error":"","sessions":[]}\n'; else demo_list; fi
    elif ! command -v herdr >/dev/null 2>&1; then
      printf '{"ok":true,"error":"","sessions":[]}\n'
    elif [[ -n $HOST ]]; then cmd_list_remote
    else cmd_list "${1-}"; fi ;;
  app-list)
    shift
    [[ -z $HOST ]] || die "app commands run locally"
    if demo_on; then
      printf '{"ok":true,"error":"","sessions":[{"kind":"app","name":"demo","host":"","spaceId":"demo","running":true,"readable":true,"stale":false,"agents":1,"blocked":0,"done":0,"working":1,"hiddenAgents":0,"agentList":[{"title":"Demo agent","status":"working","kind":null,"pane":"t1","tab":"","seq":0,"cascade":[],"cascadeKey":""}],"projects":[],"windowAddress":""}],"windowOpen":false,"machines":[]}\n'
    else cmd_app_list "${1-}"; fi ;;
  # Every write is a no-op while the demo is on, so a click during a shoot
  # cannot reach a real session.
  open) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_open "${1-}"; fi ;;
  focus) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_focus "${1-}" "${2-}"; fi ;;
  new) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_new "${1-}" "${2-}"; fi ;;
  prompt) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_prompt "${1-}" "${2-}"; fi ;;
  kill|delete)
    action=$1; shift
    valid_session_name "${1-}" || die "not a session name"
    if demo_on; then printf '{"ok":true}\n'
    elif [[ -n $HOST ]]; then remote_action "$action" "$1"
    else "cmd_$action" "$1"; fi ;;
  demo) shift; cmd_demo "${1-}" ;;
  *) die "unknown command" ;;
esac
